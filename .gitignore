ios/App/App/public/
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/App/App/capacitor.config.json
ios/App/App/config.xml

# Supabase CLI cache (created by `supabase link`)
supabase/.temp/
supabase/.branches/

