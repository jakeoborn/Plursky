{
  "permissions": {
    "deny": [
      "Agent(general-purpose)",
      "Agent(claude)",
      "Bash(gh pr close:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-note.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/plur-board-state.mjs\" --hook start",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/plur-board-state.mjs\" --hook stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
